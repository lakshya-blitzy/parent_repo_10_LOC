# parent_repo_10_LOC (Level 1) - example environment file
#
# A tracked TEMPLATE, not a live configuration. It documents every environment
# variable the Level 1 /health server reads. There are exactly two, both below.
#
# Copy it and edit the copy; keep your `.env` local and never commit it:
#
#     cp .env.example .env
#     set -a; . ./.env; set +a       # export the values into your shell
#     node server.js                 # -> listening on http://0.0.0.0:3000
#
# Nothing parses this file at run time: no dotenv package is installed, because
# this composition carries zero third-party dependencies. The application reads
# `process.env` directly, so a variable takes effect only once something has
# exported it - which also makes an inline setting the shortest way to try one:
#
#     PORT=3100 HOST=127.0.0.1 node server.js
#
# Precedence for both variables, highest first:
#
#     environment variable  ->  config/health.json  ->  compiled-in literal
#
# The literal fallback is required, not optional: it guarantees /health still
# serves a valid response when `config/health.json` is missing, which is
# precisely the failure a health endpoint has to survive.
#
# That chain governs these two listener values and nothing else:
#
#   * `name` and `version` are read from `package.json`, this tier's identity
#     manifest, with no environment step. Do not introduce APP_NAME or
#     APP_VERSION: nothing reads them.
#   * The resource path and the `status` value are resolved from
#     `config/health.json` but VALIDATED against the /health contract, which
#     admits exactly one legal value for each - `/health` and `UP`. A declaration
#     equal to it is adopted; anything else is rejected, and `server.js` prints
#     one warning line naming the rejected value while the endpoint keeps serving
#     the contract value. There is no environment variable for either, and none
#     may be added: a settable path would move the endpoint away from where a
#     probe looks for it, and a settable status would let a deployment misreport
#     its own health.
#   * Levels 2 and 3 use their own, differently named variables for their own
#     listeners. That asymmetry is deliberate: do not use their names here.
#
# Every value below is a plain, non-sensitive default, and it stays that way -
# because this file is committed, nothing private may ever be written into it.
#
# The normative definition of the endpoint and of these values is
# `docs/health-endpoint.md`.

# Address the /health listener binds to; passed straight through to
# `server.listen()`. Default: 0.0.0.0, meaning every interface, so a published
# port stays reachable from outside the host that binds it. Set it to 127.0.0.1
# to confine the listener to the loopback interface during local development.
#
# 0.0.0.0 is a BIND address only and never a destination: a probe always
# addresses http://127.0.0.1:<PORT>/health, because a health probe asserts the
# state of *this* process.
HOST=0.0.0.0

# TCP port the /health listener accepts connections on. Default: 3000, this
# tier's reserved port in the composition - Levels 2 and 3 own 8000 and 8080 -
# so all three applications can run side by side on one host. Change it locally
# if 3000 is already taken.
#
# Must be 1-65535. A value of 0 is rejected in favour of the next link of the
# chain, at every tier: 0 asks the operating system to choose a port at random,
# and an endpoint on an unpredictable port cannot be probed.
PORT=3000
